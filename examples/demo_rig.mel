// Demo: a bendy arm rig — modeled, skinned, IK'd and animated.
//   riggerator --script examples/demo_rig.mel
file -new -f;
polyPlane -w 20 -h 20 -sx 1 -sy 1 -n ground;
polyCylinder -r 0.5 -h 6 -sa 16 -sh 12 -n arm;
move 0 3 0;
string $skin = `shadingNode -asShader blinn -n skinMat`;
setAttr ($skin + ".color") -type double3 0.85 0.55 0.45;
hyperShade -assign $skin;
select -cl;
joint -p 0 0 0 -n shoulder;
joint -p 0 3 0.3 -n elbow;
joint -p 0 6 0 -n wrist;
select -r shoulder arm;
skinCluster -mi 3;
ikHandle -sj shoulder -ee wrist -n armIK;
circle -nr 0 1 0 -r 1 -n hand_ctrl;
move 0 6 0;
setAttr hand_ctrl.overrideColor 17;
select -r hand_ctrl armIK;
pointConstraint;
spaceLocator -n elbow_pole;
move 0 3 4;
select -r elbow_pole armIK;
poleVectorConstraint;
select -r hand_ctrl;
setKeyframe -at translate -t 1;
currentTime 12; move 3 3.5 0; setKeyframe -at translate -t 12;
currentTime 24; move -2 4.5 1; setKeyframe -at translate -t 24;
currentTime 36; move 0 6 0; setKeyframe -at translate -t 36;
playbackOptions -min 1 -max 36;
currentTime 12;
directionalLight -i 1; rotate -50 40 0;
select -r hand_ctrl;
